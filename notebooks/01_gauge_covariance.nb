         "\"\<eigenphases\>\"", ",", "\"\<wilson_traces_r1_r2_r3\>\""}], 
        "}"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"Grid", "[", 
    RowBox[{"gaugeTable", ",", 
     RowBox[{"Frame", "->", "All"}], ",", 
     RowBox[{"Alignment", "->", "Left"}], ",", 
     RowBox[{"ItemSize", "->", "All"}]}], "]"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
