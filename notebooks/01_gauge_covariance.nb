   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Gauge", " ", "covariance", " ", "validation", " ", "data"}], 
    "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nList", "=", 
     RowBox[{"{", 
      RowBox[{"20", ",", "40", ",", "80", ",", "160", ",", "320"}], "}"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gaugeRows", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "frames", ",", "overlaps", ",", "H", ",", "gaugeErr", ",", 
           "unitErr", ",", "muMin", ",", "phases", ",", "traces"}], "}"}], 
         ",", 
         RowBox[{
          RowBox[{"frames", "=", 
           RowBox[{"sampledFrames", "[", "nSteps", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"overlaps", "=", 
           RowBox[{"overlapMatrices", "[", "frames", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"H", "=", 
           RowBox[{"discreteHolonomyFromFrames", "[", "frames", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"gaugeErr", "=", 
           RowBox[{"gaugeCovarianceError", "[", "frames", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"unitErr", "=", 
           RowBox[{"unitaryError", "[", "H", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"muMin", "=", 
           RowBox[{"minOverlapSingularValue", "[", "overlaps", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"phases", "=", 
           RowBox[{"eigenphases", "[", "H", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"traces", "=", 
           RowBox[{"wilsonTraces", "[", 
            RowBox[{"H", ",", "3"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{
           "nSteps", ",", "gaugeErr", ",", "unitErr", ",", "muMin", ",", 
            "phases", ",", "traces"}], "}"}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"nSteps", ",", "nList"}], "}"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gaugeTable", "=", 
     RowBox[{"Prepend", "[", 
      RowBox[{"gaugeRows", ",", 
       RowBox[{"{", 
        RowBox[{
