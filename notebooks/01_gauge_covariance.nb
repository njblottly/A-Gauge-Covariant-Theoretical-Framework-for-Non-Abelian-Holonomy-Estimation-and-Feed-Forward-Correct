      "residuals"}]}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"residualPlotData", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"gaugeRows", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "2"}], "}"}]}], "]"}], "]"}], ",", 
       RowBox[{"gaugeRows", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "3"}], "}"}]}], "]"}], "]"}]}], "}"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"residualPlot", "=", 
     RowBox[{"ListLogPlot", "[", 
      RowBox[{"residualPlotData", ",", 
       RowBox[{"Joined", "->", "True"}], ",", 
       RowBox[{"PlotMarkers", "->", "Automatic"}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Number of steps N\>\"", ",", "\"\<Residual\>\""}], 
         "}"}]}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"{", 
         RowBox[{
         "\"\<Gauge covariance residual\>\"", ",", 
          "\"\<Unitarity residual\>\""}], "}"}]}], ",", 
       RowBox[{"GridLines", "->", "Automatic"}], ",", 
       RowBox[{"ImageSize", "->", "Large"}], ",", 
       RowBox[{
       "PlotLabel", "->", 
        "\"\<Gauge covariance and unitarity residuals\>\""}]}], "]"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", "residualPlot", "\n", 
