        "\"\<01_gauge_covariance.nb completed.\>\"", ",", "\"\<\>\"", ",", 
         "\"\<Purpose:\>\"", ",", 
         "\"\<Validate closed-loop gauge covariance of the polar holonomy \
estimator.\>\"", ",", "\"\<\>\"", ",", "\"\<Expected behavior:\>\"", ",", 
         "\"\<Gauge covariance residuals should be near machine \
precision.\>\"", ",", 
         "\"\<Unitarity residuals should be near machine precision.\>\"", 
         ",", "\"\<The minimum overlap singular value should remain safely \
separated from zero.\>\"", ",", "\"\<\>\"", ",", "\"\<Generated files:\>\"", 
         ",", "csvPathFull", ",", "csvPathNumeric", ",", "figPathResidualPDF",
