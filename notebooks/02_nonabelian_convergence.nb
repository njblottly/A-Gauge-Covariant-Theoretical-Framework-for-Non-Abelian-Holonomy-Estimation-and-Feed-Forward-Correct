       ",", 
       RowBox[{"\"\<phase_plot_pdf\>\"", "->", "figPathPhasesPDF"}], ",", 
       RowBox[{"\"\<log\>\"", "->", "logPath"}]}], "|>"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", "summary"}]}]], "Input",
