   "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"finiteNumberQ", "[", "x_", "]"}], ":=", 
     RowBox[{
      RowBox[{"NumberQ", "[", "x", "]"}], "&&", 
      RowBox[{"x", "=!=", "Indeterminate"}], "&&", 
      RowBox[{"x", "=!=", "ComplexInfinity"}], "&&", 
      RowBox[{"x", "=!=", 
       RowBox[{"DirectedInfinity", "[", "1", "]"}]}], "&&", 
      RowBox[{"x", "=!=", 
       RowBox[{"DirectedInfinity", "[", 
        RowBox[{"-", "1"}], "]"}]}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"toNumericCell", "[", "x_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"s", ",", "y"}], "}"}], ",", 
       RowBox[{"Which", "[", 
        RowBox[{
         RowBox[{"NumberQ", "[", "x", "]"}], ",", 
         RowBox[{"N", "[", "x", "]"}], ",", 
         RowBox[{"StringQ", "[", "x", "]"}], ",", 
         RowBox[{
          RowBox[{"s", "=", 
           RowBox[{"StringTrim", "[", "x", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"s", "===", "\"\<\>\""}], "||", 
             RowBox[{"s", "===", "\"\<NA\>\""}], "||", 
             RowBox[{"s", "===", "\"\<NaN\>\""}]}], ",", 
            RowBox[{"Missing", "[", "\"\<NotNumeric\>\"", "]"}], ",", 
            RowBox[{"Quiet", "[", 
             RowBox[{"Check", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"y", "=", 
                 RowBox[{"ToExpression", "[", "s", "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"NumberQ", "[", "y", "]"}], ",", 
                  RowBox[{"N", "[", "y", "]"}], ",", 
                  RowBox[{"Missing", "[", "\"\<NotNumeric\>\"", "]"}]}], 
                 "]"}]}], ",", 
               RowBox[{"Missing", "[", "\"\<NotNumeric\>\"", "]"}]}], "]"}], 
             "]"}]}], "]"}]}], ",", "True", ",", 
         RowBox[{"Missing", "[", "\"\<NotNumeric\>\"", "]"}]}], "]"}]}], 
