       RowBox[{"\"\<nonabelian_error_decreases\>\"", "->", 
        RowBox[{"(", 
         RowBox[{"nonAbelianFinalError", "<", "nonAbelianInitialError"}], 
         ")"}]}], ",", 
       RowBox[{"\"\<frame_pipeline_error_decreases\>\"", "->", 
        RowBox[{"(", 
         RowBox[{"frameFinalError", "<", "frameInitialError"}], ")"}]}], ",", 
       
       RowBox[{"\"\<frame_projector_step_decreases\>\"", "->", 
        RowBox[{"(", 
         RowBox[{
         "frameFinalProjectorStep", "<", "frameInitialProjectorStep"}], 
         ")"}]}], ",", 
       RowBox[{"\"\<left_correction_error_decreases\>\"", "->", 
        RowBox[{"(", 
         RowBox[{
         "leftFinalCorrectionError", "<", "leftInitialCorrectionError"}], 
         ")"}]}], ",", 
       RowBox[{"\"\<right_correction_error_decreases\>\"", "->", 
        RowBox[{"(", 
         RowBox[{
         "rightFinalCorrectionError", "<", "rightInitialCorrectionError"}], 
         ")"}]}], ",", 
       RowBox[{"\"\<left_final_fidelity_near_one\>\"", "->", 
        RowBox[{"(", 
         RowBox[{"leftFinalFidelity", ">", "0.999"}], ")"}]}], ",", 
       RowBox[{"\"\<right_final_fidelity_near_one\>\"", "->", 
        RowBox[{"(", 
         RowBox[{"rightFinalFidelity", ">", "0.999"}], ")"}]}], ",", 
       RowBox[{"\"\<scaled_noise_slopes_near_one\>\"", "->", 
        RowBox[{"And", "@@", 
