   RowBox[{
    RowBox[{"logText", "=", 
     RowBox[{"StringRiffle", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "\"\<05_conditioning_noise_sensitivity.nb completed.\>\"", ",", 
         "\"\<\>\"", ",", "\"\<Purpose:\>\"", ",", 
         "\"\<Validate conditioning dependence of the polar holonomy \
estimator under noisy overlap matrices.\>\"", ",", "\"\<\>\"", ",", 
         "\"\<Baseline:\>\"", ",", 
         RowBox[{"\"\<Rank-2 tangent-frame loop with N_base = \>\"", "<>", 
          RowBox[{"ToString", "[", "nBase", "]"}], "<>", "\"\<.\>\""}], ",", 
         RowBox[{"\"\<Base minimum singular value = \>\"", "<>", 
          RowBox[{"ToString", "[", 
           RowBox[{
           "baseDiagnostics", "[", "\"\<base_min_singular_value\>\"", "]"}], 
           "]"}], "<>", "\"\<.\>\""}], ",", "\"\<\>\"", ",", 
         "\"\<Controlled conditioning construction:\>\"", ",", 
         "\"\<Each clean overlap is replaced by polar(M_k) . \
DiagonalMatrix[{1, mu}], so the polar factor is unchanged while the smallest \
singular value is controlled.\>\"", ",", "\"\<\>\"", ",", 
         "\"\<Scaled-noise test:\>\"", ",", "\"\<eta = rho * mu_min.\>\"", 
         ",", "\"\<Expected behavior: mean holonomy error scales \
approximately linearly with rho = eta/mu_min for small perturbations.\>\"", 
         ",", "\"\<\>\"", ",", "\"\<Fixed-eta test:\>\"", ",", 
         RowBox[{"\"\<eta = \>\"", "<>", 
          RowBox[{"ToString", "[", "fixedEta", "]"}], "<>", "\"\<.\>\""}], 
         ",", "\"\<Expected behavior: mean holonomy error increases as mu_min \
decreases.\>\"", ",", "\"\<\>\"", ",", "\"\<Trials per point:\>\"", ",", 
         RowBox[{"ToString", "[", "trials", "]"}], ",", "\"\<\>\"", ",", 
         "\"\<Scaled-noise slope table:\>\"", ",", 
         RowBox[{"ToString", "[", 
          RowBox[{"scaledSlopeRows", ",", "InputForm"}], "]"}], ",", 
         "\"\<\>\"", ",", "\"\<Fixed-eta fit summary:\>\"", ",", 
         RowBox[{"ToString", "[", 
          RowBox[{"fixedFitSummary", ",", "InputForm"}], "]"}], ",", 
         "\"\<\>\"", ",", "\"\<Base diagnostics:\>\"", ",", 
         RowBox[{"ToString", "[", 
          RowBox[{"baseDiagnostics", ",", "InputForm"}], "]"}], ",", 
         "\"\<\>\"", ",", "\"\<Generated files:\>\"", ",", "csvPathScaled", 
         ",", "csvPathSlopes", ",", "csvPathFixed", ",", 
         "csvPathFrameBaseline", ",", "figPathScaledPDF", ",", 
         "figPathScaledPNG", ",", "figPathFixedPDF", ",", "figPathFixedPNG", 
